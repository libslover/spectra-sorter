```gitignore
# Python
__pycache__/
*.pyc
*.pyo
*.pyd

# Dependencies
.venv/
venv/
env/
.env
*.env

# Logs
*.log

# Temporary files
*.tmp
*.temp
*.swp

# OS generated files
.DS_Store
Thumbs.db

# Build artifacts
build/
dist/
*.egg-info/
.coverage
htmlcov/
.coverage.*
.tox/
.nox/

# Editors
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj.user
```